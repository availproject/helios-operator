# The source chain is the chain that the light client will sync from.
# Must serve the light-client API. On Sepolia after the Gloas fork Chainstack does not; Lodestar does.
SOURCE_CONSENSUS_RPC_URL=
# Execution RPC of the same chain. Required from the Gloas fork: the operator fetches the finalized
# execution block header from it.
SOURCE_EXECUTION_RPC_URL=
SOURCE_CHAIN_ID="11155111"
# Set to mock for testing, or network to generate proofs on the Succinct Prover Network.
SP1_PROVER=
# SP1 private key for the network
NETWORK_PRIVATE_KEY=
# succinct production2 rpc url
NETWORK_RPC_URL=
# Avail node HTTP(S) RPC, used to read the Vector head and to submit proofs. WebSocket URLs do not work.
# The node must serve the Avail RPCs avail-rust needs (system_fetchEventsV1, system_fetchExtrinsicsV1).
AVAIL_RPC=
AVAIL_SECRET="//Alice"
# Loop delays in minutes after one successful iteration
LOOP_DELAY_MINS="5"